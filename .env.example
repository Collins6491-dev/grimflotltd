# Select the environment explicitly in deployment processes.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
SITE_URL=https://www.example.com
ALLOWED_HOSTS=www.example.com,example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
ADMIN_URL=admin
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_CONN_MAX_AGE=60

# SMTP email (implemented as the production email backend; keep blank until configured).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GRIMFLOT LTD <noreply@example.com>
SERVER_EMAIL=GRIMFLOT LTD <errors@example.com>

# Paystack.  Never expose PAYSTACK_SECRET_KEY or PAYSTACK_WEBHOOK_SECRET in a
# browser bundle. The public key is only needed when a future hosted form uses it.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Persistent S3-compatible media storage (required in production).
MEDIA_STORAGE_PROVIDER=s3
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_CUSTOM_DOMAIN=

# Redis is provisioned before rate limiting and shared caching are enabled.
REDIS_URL=redis://user:password@host:6379/1
LOG_LEVEL=INFO
